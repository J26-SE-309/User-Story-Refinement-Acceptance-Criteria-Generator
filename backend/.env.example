# Copy to backend/.env to override the defaults in app/config.py. Never commit .env.
STORY_LLM_BASE_URL=http://localhost:11434
STORY_LLM_MODEL=llama3.2
STORY_LLM_TIMEOUT_SECONDS=30
STORY_CANDIDATE_COUNT=3
# Local directory containing the fine-tuned FLAN-T5 tokenizer and model files.
STORY_MODEL_PATH=../../models/story-refinement-model
STORY_MODEL_DEVICE=auto
STORY_DATA_DIR=../../Datasets/story-refinement
DATABASE_URL=postgresql+psycopg://story_user:story-local@localhost:5442/story_db
CORS_ORIGINS=["http://localhost:3000"]
